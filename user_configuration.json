{
    "app_config": {
        "audio_config": {
            "audio": "pipewire"
        },
        "bluetooth_config": {
            "enabled": true
        },
        "fonts_config": {
            "fonts": [
                "noto-fonts",
                "noto-fonts-emoji",
                "noto-fonts-cjk",
                "ttf-liberation",
                "ttf-dejavu"
            ]
        },
        "print_service_config": {
            "enabled": true
        }
    },
    "archinstall_language": "English",
    "auth_config": {},
    "bootloader_config": {
        "bootloader": "Grub",
        "removable": false,
        "uki": false
    },
    "custom_commands": [],
    "disk_config": {
        "config_type": "pre_mounted_config",
        "mountpoint": "/mnt"
    },
    "hostname": "pc",
    "kernels": [
        "linux",
        "linux-lts"
    ],
    "locale_config": {
        "console_font": "default8x16",
        "kb_layout": "us",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    },
    "mirror_config": {
        "custom_repositories": [],
        "custom_servers": [],
        "mirror_regions": {
            "Worldwide": [
                "https://fastly.mirror.pkgbuild.com/$repo/os/$arch",
                "https://geo.mirror.pkgbuild.com/$repo/os/$arch",
                "https://ftpmirror.infania.net/mirror/archlinux/$repo/os/$arch",
                "https://mirror.rackspace.com/archlinux/$repo/os/$arch"
            ]
        },
        "optional_repositories": []
    },
    "network_config": {
        "type": "nm"
    },
    "ntp": true,
    "packages": [],
    "pacman_config": {
        "color": true,
        "parallel_downloads": 10
    },
    "profile_config": {
        "gfx_driver": "Nvidia (open kernel module for newer GPUs, Turing+)",
        "greeter": "gdm",
        "profile": {
            "custom_settings": {
                "GNOME": {}
            },
            "details": [
                "GNOME"
            ],
            "main": "Desktop"
        }
    },
    "script": null,
    "services": [],
    "swap": {
        "algorithm": "zstd",
        "enabled": false
    },
    "timezone": "Europe/Paris",
    "version": "4.4"
}